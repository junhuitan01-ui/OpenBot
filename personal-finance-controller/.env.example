# KRONA configuration. Copy to .env and fill in. Never commit .env.
# This is KRONA's own bot. Do NOT reuse the token of any other bot (e.g. Daybreak).

# Token from @BotFather for the KRONA bot.
KRONA_TELEGRAM_BOT_TOKEN=replace-with-your-krona-bot-token

# Your numeric Telegram user ID (message @userinfobot to find it). Everyone else is rejected.
KRONA_AUTHORISED_USER_ID=000000000

# Anthropic API key for natural-language understanding. Optional: without it only simple
# phrasings ("Spent $12 on lunch") are understood; reports and commands still work.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Optional settings (defaults shown).
# KRONA_DB_PATH=./data/krona.sqlite3
# KRONA_CLAUDE_MODEL=claude-opus-5-5
# KRONA_CLAUDE_TIMEOUT_SECONDS=20
# Server-side refusal fallbacks (Anthropic beta). Set to off if your account rejects the beta.
# KRONA_CLAUDE_FALLBACKS=on
# Daily briefing hour in Asia/Singapore, and the last hour a missed briefing is still sent.
# KRONA_BRIEFING_HOUR=7
# KRONA_BRIEFING_CATCHUP_UNTIL_HOUR=12
# KRONA_LOG_LEVEL=INFO
